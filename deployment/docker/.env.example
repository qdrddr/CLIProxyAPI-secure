# Copy to .env and adjust.
#
# Hub (no local build):
#   CLI_PROXY_PULL_POLICY=always
#   docker compose pull && docker compose up -d --no-build
#
# Local build:
#   docker compose build cli-proxy-api && docker compose up -d
#   docker compose up -d --build

# ------------------------------------------------------------------------------
# CLIProxyAPI (nono-wrapped)
# ------------------------------------------------------------------------------
# CLI_PROXY_IMAGE=bbkudk/cliproxyapi-secure:latest
# CLI_PROXY_PULL_POLICY=always
# CLI_PROXY_API_TAG=v8.0.47
# CLI_PROXY_PORT=8317
# CLI_PROXY_CONFIG_PATH=./config.yaml
# Sign in to the Management UI with management.secret-key from that file.
# CLI_PROXY_AUTH_PATH=./auths
# NONO_VERSION=0.80.0

# ------------------------------------------------------------------------------
# Management Center (nono-hardened; build from ../Cli-Proxy-API-Management-Center-secure or pull Hub)
# ------------------------------------------------------------------------------
# MANAGEMENT_IMAGE=bbkudk/cli-proxy-api-management-center-secure:v1.26.7
# MANAGEMENT_VERSION=v1.26.7
# MANAGEMENT_PORT=8081
# MANAGEMENT_PULL_POLICY=always
# On Apple Silicon leave MANAGEMENT_PLATFORM unset (native arm64 + Landlock). Avoid linux/amd64 here.

# ------------------------------------------------------------------------------
# Postgres / Git / Object storage (optional)
# ------------------------------------------------------------------------------
# PGSTORE_DSN=postgresql://user:pass@localhost:5432/cliproxy
# GITSTORE_GIT_URL=https://github.com/your-org/cli-proxy-config.git
# GITSTORE_GIT_TOKEN=ghp_xxx
# OBJECTSTORE_ENDPOINT=https://s3.example.com
