{
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "claude",
    "version": "1.0.0",
    "description": "CLIProxyAPI in Docker: nono sandbox for Claude/Anthropic OAuth and API egress."
  },
  "filesystem": {
    "allow": [
      "/CLIProxyAPI",
      "/root/.cli-proxy-api"
    ]
  },
  "network": {
    "network_profile": "developer",
    "allow_domain": [
      "platform.claude.com",
      "api.anthropic.com",
      "claude.ai",
      "claude.com",
      "console.anthropic.com"
    ],
    "listen_port": [8317, 8085, 1455, 54545, 51121, 11451]
  }
}
